# ============================================================
# 构建镜像时排除的文件
#
# 作用有二：
#   1. 加快构建 —— 不把这些文件传给 Docker daemon
#   2. 更安全   —— 密钥、数据库文件、日志绝不会被打进镜像
# ============================================================

# ---------- 密钥：绝不进镜像 ----------
# 应用配置在运行时通过 compose 的 env_file 注入，镜像里不需要也不该有
.env
**/.env
**/.env.*
!**/.env.example

# ---------- 版本控制 ----------
.git
.gitignore
.gitattributes

# ---------- Python 缓存与虚拟环境 ----------
**/__pycache__/
**/*.py[cod]
**/*$py.class
**/venv/
**/.venv/
**/env/
*.egg-info/
.pytest_cache/

# ---------- 运行期数据：由卷提供，不能烤进镜像 ----------
# 否则会把本机的索引/文档一起打包，部署到服务器后变成"幽灵数据"
backend/faiss_index/
backend/documents/
documents/
*.db
*.sqlite3

# ---------- 日志与临时文件 ----------
**/*.log
**/logs/
**/*.tmp

# ---------- 本地验证脚本：属于开发工具，不参与运行 ----------
**/_verify_*.py
**/_verify_*.js
_verify_*.js

# ---------- 数据库脚本 ----------
# init.sql 是通过 compose 的 volumes 挂进 MySQL 容器的，
# 后端镜像不需要它。
database/

# ---------- 编辑器与系统文件 ----------
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# ---------- 文档 ----------
*.md
!README.md
